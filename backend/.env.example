# Copy to backend/.env and adjust. All values are optional (defaults in config.py).

# Locally hosted, OpenAI-compatible LLM endpoint.
# Examples:
#   llama.cpp:  LLM_BASE_URL=http://127.0.0.1:8001/v1
#   vLLM:       LLM_BASE_URL=http://localhost:8000/v1
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=not-set
LLM_MODEL=local-model

# HuggingFace tokenizer id or local path (used for token counting + chunking).
# Point at a local model dir for offline use, e.g. /models/Qwen2.5-7B-Instruct
TOKENIZER_NAME=gpt2

# Storage locations (relative to the backend/ working directory).
DATABASE_PATH=data/navee.db
TINYDB_PATH=data/navee.json
CHROMA_PATH=data/chroma

# Comma-free JSON list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=["http://localhost:5173"]

# Context budgets (tokens). CONVERSE_TOKEN_BUDGET is the total per-turn context
# envelope: SYSTEM_PROMPT + TOOL + SKILL (name + short description) + USER_FACTS
# (user facts summary) + latest compaction + current turn (agent + user
# message). The system prompt, tools, and current turn roll (variable); the
# rest are fixed allocations.
CONVERSE_TOKEN_BUDGET=64000
# Token cap for the compaction summary of old messages.
COMPACTION_BUDGET=16384
# Token cap for skill references (name + short description).
SKILL_BUDGET=8192
# Token cap for the user facts summary injected into the conversation.
USER_FACTS_BUDGET=1024
