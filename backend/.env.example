# Copy to backend/.env and adjust. All values are optional (defaults in config.py).

# Locally hosted, OpenAI-compatible LLM endpoint.
# Examples:
#   llama.cpp:  LLM_BASE_URL=http://127.0.0.1:8001/v1
#   vLLM:       LLM_BASE_URL=http://localhost:8000/v1
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=not-set
LLM_MODEL=local-model

# HuggingFace tokenizer id or local path (used for token counting + chunking).
# Point at a local model dir for offline use, e.g. /models/Qwen2.5-7B-Instruct
TOKENIZER_NAME=gpt2

# Storage locations (relative to the backend/ working directory).
DATABASE_PATH=data/navee.db
TINYDB_PATH=data/navee.json
CHROMA_PATH=data/chroma

# Comma-free JSON list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=["http://localhost:5173"]
